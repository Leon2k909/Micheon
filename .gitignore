# Generated by the build (npm run build:catalogue-db). 13 MB, rewritten on
# every build — committing it would put a new binary blob in history each time.
public/catalogue.db

# Generated by the build (npm run build:content-packs). 5.3 MB of JSON that is
# derived entirely from the packs in src/lib, the same way public/catalogue.db
# is — committing it would put a second copy of the whole course in every diff.
public/content/

# Instructions for the coding assistant, not project content. Kept out of the
# repository because it is about how to work here rather than about what the
# app does, and this repository is public.
CLAUDE.md
