{
  "compilerOptions": {
    // Without this, TS 6+ treats the deprecated `moduleResolution: node10` and
    // `baseUrl` below as ERRORS and aborts before checking a single source
    // file — so `tsc --noEmit` exits 0 having verified nothing. That is how a
    // missing `Mic2` import shipped: it only rendered inside Electron, and the
    // typechecker that should have caught it was never actually running.
    "ignoreDeprecations": "6.0",
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    // "Bundler" matches how Vite actually resolves. The old "Node" (node10)
    // setting has been REMOVED in TS 6, not merely deprecated, so it aborted
    // the whole run — see the note on ignoreDeprecations above.
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    // No baseUrl: it has been removed too. Path mappings without one resolve
    // relative to this file, which is what the "./src/*" below already assumed.
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
