{
  "name": "germ",
  "private": true,
  "version": "1.0.65",
  "description": "Micheon — offline lessons with premium voice, spaced repetition, and gaming vocabulary.",
  "author": "Leon",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -n vite,tts -c cyan,magenta \"vite\" \"node server/index.js\"",
    "dev:web": "vite",
    "server": "node server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "electron": "npm run build && electron .",
    "electron:run": "electron .",
    "electron:dist": "npm run build && electron-builder --win --publish never",
    "release": "npm run build && electron-builder --win --publish always",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.germ.germanlab",
    "productName": "Micheon",
    "files": [
      "electron/**",
      "server/**",
      "dist/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "Leon2k909",
      "repo": "Micheon",
      "releaseType": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "@astryxdesign/core": "^0.1.8",
    "@astryxdesign/theme-butter": "^0.1.8",
    "@astryxdesign/theme-neutral": "^0.1.8",
    "@huggingface/transformers": "^4.2.0",
    "@radix-ui/react-progress": "^1.1.14",
    "@radix-ui/react-slot": "^1.3.1",
    "@radix-ui/react-tabs": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.14",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react-grid-layout": "^1.3.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "edge-tts-universal": "^1.4.0",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "framer-motion": "^12.42.2",
    "level": "^10.0.0",
    "lucide-react": "^1.26.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-grid-layout": "^2.2.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.3",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "onnxruntime-web": "1.27.0",
    "sharp": "0.35.3",
    "shell-quote": "1.10.0"
  }
}
